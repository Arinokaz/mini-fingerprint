{
  "name": "@company/marketing-telemetry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Angular browser telemetry interceptor backed by WebAssembly.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@angular/common": ">=17.0.0",
    "@angular/core": ">=17.0.0",
    "rxjs": "^7.8.0"
  },
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "test:release": "tsx --test tests/release.test.ts",
    "build": "node scripts/build.mjs --variant embedded --out-dir dist",
    "build:release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
